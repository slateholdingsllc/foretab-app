# Public Supabase config — safe to ship to the browser. NEXT_PUBLIC_* vars
# are inlined into the bundle at build time.
#
# NEXT_PUBLIC_SUPABASE_URL = the customer-facing auth/REST/storage URL.
# Post-2026-06-01 cutover: custom auth domain auth.foretab.com (Supabase Pro).
# The underlying project ref (mjrridklwkdwzbethbjq) is unchanged — JWT iss
# claims still resolve to the project's stable internal identity, so old
# tokens minted via the supabase.co URL continue to validate cleanly.
# Cookie names re-key from sb-mjrridklwkdwzbethbjq-auth-token to
# sb-auth-auth-token at cutover (one-time soft re-login for any session
# active at the moment of cutover).
NEXT_PUBLIC_SUPABASE_URL=https://auth.foretab.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — drives OAuth redirects and emails. Set per environment:
# local dev: http://localhost:3000
# preview:   https://foretab-app-git-<branch>-slateholdingsllc.vercel.app
# prod:      https://app.foretab.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signup flow version. See src/lib/actions/auth.ts:signupFlowVersion()
# and the durable-fix spec (2026-05-30).
#   'legacy' (default) — supabase.auth.signUp + Supabase's built-in
#                        Brevo SMTP + email template. Historic path;
#                        prone to silent Site URL fallback + email
#                        template / PKCE-prefix drift.
#   'admin_link'       — admin.createUser + admin.generateLink + Resend
#                        send. Durable: we control URL + SMTP. The
#                        post-click chain (Supabase /auth/v1/verify →
#                        /auth/callback → trigger → /state-selection)
#                        is unchanged.
# Cutover plan: smoke-test on a synthetic account with this flipped in
# preview → flip in production → 24h grace for in-flight signups →
# disable Supabase built-in send in dashboard → 7 days later remove the
# legacy branch.
SIGNUP_FLOW_VERSION=legacy
